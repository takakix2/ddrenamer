{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDRenamer",
  "version": "0.1.0",
  "identifier": "com.takaki2.ddrenamer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DDRenamer",
        "width": 680,
        "height": 638,
        "resizable": true,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}